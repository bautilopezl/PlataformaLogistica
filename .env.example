# Copiar a .env y completar. No subir .env al repositorio.

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=logistica
# Identidad de administración (migraciones / setup_databases.py)
PG_ADMIN_USER=logistica_admin
PG_ADMIN_PASSWORD=cambiar_esta_clave
# Identidad de ejecución habitual de la aplicación (privilegios limitados, ver db/postgres/900_grants.sql)
PG_APP_USER=logistica_app
PG_APP_PASSWORD=cambiar_esta_clave_app

# --- MongoDB ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=logistica
MONGO_ADMIN_USER=logistica_admin
MONGO_ADMIN_PASSWORD=cambiar_esta_clave

# --- Neo4j ---
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambiar_esta_clave

# --- Aplicación ---
LOG_LEVEL=INFO
LOG_DIR=logs
# Timeout de conexión a cada motor, en segundos
DB_TIMEOUT_S=5

SESSION_HOURS=8
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=4
